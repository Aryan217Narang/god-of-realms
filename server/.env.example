# Port for backend server
PORT=5000

# JWT Signing Secret (generate a strong random secret in production)
JWT_SECRET=realm_quest_jwt_secret_sacred_key_2026_super_secure

# Optional: PostgreSQL Database URL (e.g. from Render Postgres, Neon, or Supabase)
# If left unset or empty, the backend automatically uses a local persistent JSON database in server/data/
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGIN=*
